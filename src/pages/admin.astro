---
const configUrl = "/admin/config.yml";
const adminUrl = "/admin/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link href={configUrl} type="text/yaml" rel="cms-config-url" />
    <title>Content Manager</title>

    <link rel="icon" href={`${adminUrl}favicon.ico`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${adminUrl}apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${adminUrl}manifest.webmanifest`} />
    <meta name="theme-color" content="#0f2747" />
    <script>
      import { init } from "@sveltia/cms";
      init();
    </script>
  </head>
  <body>
    <script>
      import { link } from "../lib/links";
      const adminUrl = link('/admin/');

      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register(`${adminUrl}sw.js`, {
          scope: adminUrl,
        });
      }
    </script>
  </body>
</html>
