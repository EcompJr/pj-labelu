---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LabeluEvent } from "../../lib/agenda/event";
import { linkedDataFromEvent } from "../../lib/agenda/metadata";
import GoBackButton from "../../components/Agenda/GoBackButton.astro";
import { Icon } from "astro-icon/components";

export const getStaticPaths = async () =>
  (await getCollection("schedule")).map((evento) => ({
    params: { slug: evento.id },
    props: evento,
  }));

type Props = CollectionEntry<"schedule">;

const props = Astro.props;
const { Content } = await render(props);

const event = new LabeluEvent({
  agenda: props.data.agenda,
  category: props.data.category,
  title: props.data.title,
  start: props.data.date,
  end: props.data.enddate,
  time: props.data.time,
  local: props.data.local,
})
---

<BaseLayout title={`${event.title} — Agenda — Labelu`} description={event.agenda}>
  <article class="max-w-180 mx-auto px-4 py-8">
    <nav class="mb-8" aria-label="Navegação estrutural">
      <GoBackButton />
    </nav>
    <header class="mb-6">
      <div
        class="flex justify-between items-center flex-wrap gap-2 mb-4 max-[720px]:flex-col max-[720px]:items-start">
        <time
          datetime={event.localDate[0].split("T")[0]}
          class="text-sm text-secondary-text font-bold"
          transition:name={`time-${props.id}`}
        >
          {event.localDate[0]}
          {event.time && <span class="font-normal"> · {event.time}</span>}
        </time>
        <div class="flex gap-1.5 flex-wrap">
          <span class="text-[0.7rem] uppercase tracking-wider px-2.5 py-0.5 rounded-full font-semibold whitespace-nowrap bg-accent-800 text-white"
            transition:name={`finished-${props.id}`}>
            (
              {event.status == 'open' && "Aberto"}
              {event.status == 'ongoing' && "Em andamento"}
              {event.status == 'finished' && "Finalizado"}
            )
          </span>
          <span class="text-[0.7rem] uppercase tracking-wider px-2.5 py-0.5 rounded-full font-semibold whitespace-nowrap bg-raised text-body"
            transition:name={`category-${props.id}`}>
            {event.category}
          </span>
        </div>
      </div>

      <!-- h1 font/color/tracking/leading all from @layer base -->
      <h1 class="text-4xl mb-3 max-[720px]:text-3xl" transition:name={`title-${props.id}`}>
        {event.title}
      </h1>

      <!-- agenda summary — leading comes from @layer base p -->
      <p class="text-lg text-secondary-text mb-3" transition:name={`description-${props.id}`}>
        {event.agenda}
      </p>

      {
        event.local && (
          <p
            transition:name={`location-${props.id}`}
            class="text-sm text-secondary-text flex items-center gap-1.5">
            <Icon name="map-pin-area" class="w-4 h-4 text-accent-600" />
            {event.local}
          </p>
        )
      }
    </header>
    <hr class="border-none border-t-2 border-border my-6" />
    <div class="prose prose-stone max-w-none evento-body text-justify">
      <Content />
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(linkedDataFromEvent(event))} />
</BaseLayout>
