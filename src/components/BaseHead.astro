---
import "../styles/global.css";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { Font } from "astro:assets";
import { getSiteConfig } from "../lib/site-config";
interface Props {
  title: string;
  description: string;
  image?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteConfig = await getSiteConfig();

const {
  title,
  description,
  image = "/og.jpg",
  structuredData = [],
} = Astro.props;

// URLs for structured data and meta tags
const siteURL = Astro.site?.toString().replace(/\/$/, "");
const logoURL = `${siteURL}/assets/logo-labelu.png`;
const imagePath = image.startsWith("/") ? image : `/${image}`;
const ogImageURL = `${siteURL}${imagePath}`;
const basePath = "/";

const organizationStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteURL}#organization`,
  name: "Labelu",
  legalName: "Laboratório de História e Memória da Luta de Classes",
  url: siteURL,
  logo: {
    "@type": "ImageObject",
    url: logoURL,
  },
  image: ogImageURL,
  description: SITE_DESCRIPTION,
  email: siteConfig.contactEmail,
  sameAs: [siteConfig.instagramUrl, siteConfig.youtubeUrl].filter(Boolean),
  address: {
    "@type": "PostalAddress",
    ...siteConfig.address,
  },
  location: siteConfig.location,
};
const extraStructuredData = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
const jsonLd =
  extraStructuredData.length > 0
    ? {
        "@context": "https://schema.org",
        "@graph": [organizationStructuredData, ...extraStructuredData],
      }
    : organizationStructuredData;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Sitemap & RSS -->
<link rel="sitemap" href={new URL("sitemap-index.xml", Astro.site)} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" />
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/apple-touch-icon.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/favicon-32x32.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="16x16"
  href="/favicon-16x16.png"
/>
<link rel="manifest" href="/site.webmanifest" />
<meta name="msapplication-TileColor" content="#7d2418" />
<meta name="msapplication-config" content="/browserconfig.xml" />
<meta name="theme-color" content="#7d2418" />

<!-- Fonts -->
<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-heading" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Labelu" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta property="twitter:url" content={canonicalURL} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<script define:vars={{ basePath }}>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register(`${basePath}sw.js`, {
      scope: basePath,
    });
  }
</script>
