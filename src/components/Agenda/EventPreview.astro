---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { LabeluEvent } from "../../lib/agenda/event";

import Link from "../Link.astro";
import EventTime from "./EventTime.astro";
import StatusBadge from "./StatusBadge.astro";
import CategoryBadge from "./CategoryBadge.astro";
import Location from "./Location.astro";

type EventEntry = CollectionEntry<"schedule">;

interface Props {
  entry: EventEntry
}

const { entry } = Astro.props
const { data } = entry

const event = new LabeluEvent({
  agenda: data.agenda,
  category: data.category,
  title: data.title,
  start: data.date,
  end: data.enddate,
  time: data.time,
  local: data.local,
})

const eventUrl = `/agenda/${entry.id}/`
---

<li class="relative pl-8 pb-8 border-l-2 border-accent-500 timeline-item">
  <div
    class="absolute -left-2.5 top-0 w-4 h-4 bg-accent-500 border-2 rounded-full"
    aria-hidden="true"
  >
  </div>

  <article class="bg-surface rounded-xl px-6 py-5 shadow-sm">
    <header class="flex justify-between items-center flex-wrap gap-2 mb-2">
      <EventTime eventId={entry.id} intervalDays={event.localDate} time={event.time} />
      <div class="flex gap-1.5 flex-wrap">
        <StatusBadge eventId={entry.id} status={event.status} />
        <CategoryBadge eventId={entry.id} category={event.category} />
      </div>
    </header>
    <h2 class="text-xl font-semibold mt-1 mb-2" transition:name={`title-${entry.id}`}>
      <Link href={eventUrl} class="text-title no-underline hover:text-accent-500 transition-colors duration-150">
        {event.title}
      </Link>
    </h2>

    <p class="text-sm text-secondary-text mb-3 leading-relaxed" transition:name={`description-${entry.id}`}>
      {event.agenda}
    </p>
    {event.local && <Location eventId={entry.id} local={event.local} />}

    <a href={eventUrl} class="text-sm text-accent-600 font-semibold no-underline hover:underline inline-block">
      Ver detalhes →
    </a>
  </article>
</li>
