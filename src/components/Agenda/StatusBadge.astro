---
import type { Status } from '../../lib/agenda/event';
import Badge from './Badge.astro';

type Props = {
  eventId: string
  status: Status
}

const {eventId, status} = Astro.props as Props

const content = {
  open: "Aberto",
  ongoing: "Em andamento",
  finished: "Finalizado"
}
---

<Badge id={`status-${eventId}`} variant="accent">
  {content[status]}
</Badge>
